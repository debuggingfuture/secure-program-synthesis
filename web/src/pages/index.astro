---
import Base from "../layouts/Base.astro";
---

<Base
  title="Postern — Lean-verified access gateway for agentic data lakehouses"
  description="A research artifact pairing five Lean 4 theorems about column-grant policy rewriting with a Rust gateway and a conformance harness."
>
  <main class="landing">
    <section class="hero">
      <p class="hero__eyebrow">Pre-publication research artifact</p>
      <h1 class="hero__title">
        Postern: a Lean-verified access gateway for agentic data lakehouses
      </h1>
      <p class="hero__subtitle">
        Plan-level rewriting against a column-grant policy. The Lean
        rewriter is <code>sorry</code>-free; a Rust mirror runs the
        same logic; a conformance harness keeps them byte-equal on a
        hand-curated JSON corpus. The Datalog evaluator and
        Biscuit-Datalog dispatch are in progress.
      </p>
      <div class="hero__ctas">
        <a class="cta cta--primary" href="/paper">Read the paper</a>
        <a class="cta" href="/paper.pdf">Download PDF</a>
        <a class="cta" href="/slides">Open slides ↗</a>
        <a class="cta" href="/demo">Try the rewriter (WASM)</a>
      </div>
    </section>

    <section class="slides-embed" aria-label="8-slide overview">
      <div class="slides-embed__head">
        <h2>8-slide overview</h2>
        <p class="muted">
          Use arrow keys / swipe to navigate. The deck is also live at
          <a href="/slides">/slides</a> for full-screen viewing.
        </p>
      </div>
      <div class="slides-embed__frame">
        <iframe
          src="/slides"
          title="Postern — 8-slide overview"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="repo-pointer">
      <h2>Where things live</h2>
      <ul class="paths">
        <li><code>paper/paper.md</code> — the paper (Pandoc markdown).</li>
        <li><code>verifier/lean/Postern.lean</code> — the proven rewriter theorems.</li>
        <li><code>verifier/lean/Datalog.lean</code> — Datalog eval (3 theorems stated, sorries open).</li>
        <li><code>prototype/crates/postern-core</code> — Rust mirror of the rewriter.</li>
        <li><code>prototype/crates/postern-wasm</code> — the WASM surface this site loads.</li>
        <li><code>scenarios/financial-institution</code> — the policy + demo data shape.</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .landing {
    max-width: 980px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .hero {
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .hero__title {
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.18;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .hero__subtitle {
    font-size: 1.05rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }

  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }

  .cta {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--bg-elevated);
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cta--primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .cta--primary:hover {
    color: #fff;
    opacity: 0.92;
  }

  /* Slides break out of the .landing 980px column and span the
     viewport — at 16:9 the deck reads much better full-bleed. */
  .slides-embed {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    margin: 2.4rem 0 0;
    padding: 0 clamp(1rem, 4vw, 3rem);
    box-sizing: border-box;
  }

  .slides-embed__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  .slides-embed__head h2 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0;
  }

  .slides-embed__head p {
    margin: 0;
    font-size: 0.86rem;
  }

  .slides-embed__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 1400px;
    margin: 0 auto;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
  }

  .slides-embed__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .repo-pointer {
    margin-top: 3rem;
  }

  .paths {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    padding-left: 1.2rem;
  }

  .paths li {
    margin: 0.2rem 0;
  }
</style>
