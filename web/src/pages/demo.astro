---
import Base from "../layouts/Base.astro";
import {
  CATALOG,
  POLICY,
  TABLES,
  SENSITIVE,
  PRINCIPALS,
  policyAsDatalog,
} from "../lib/scenario-data.ts";
// Inline the policy file at build time via Vite's `?raw` import.
// Path is web-rooted; Vite walks up to find the file.
import policyText from "../../../scenarios/financial-institution/policy.postern?raw";
const datalogText = policyAsDatalog(POLICY);

const relations = Object.keys(CATALOG);

// Serialise data the client form needs. `tables` carries the sample
// rows so the result panel can show actual dataframes (what the agent
// would receive before vs. after the rewrite).
const demoConfig = {
  catalog: CATALOG,
  policy: POLICY,
  principals: PRINCIPALS,
  sensitive: SENSITIVE,
  tables: TABLES,
};
---

<Base
  title="Postern — interactive demo"
  description="Pick a principal, a relation, and columns to project. The WASM-compiled Postern rewriter shows the rewritten plan or refusal reason."
>
  <main class="demo">
    <header class="demo__head">
      <p class="eyebrow">Interactive demo</p>
      <h1>Financial-institution scenario</h1>
      <p class="lede">
        A retail bank's data lakehouse holds three tables —
        <code>users_data</code>, <code>cards_data</code>,
        <code>transactions_data</code> — ingested from upstream CRM,
        card-management, and ledger systems. Three internal
        departments query the lake through LLM agents. Each
        department has a different reason to look at the same
        rows, so the policy gates <em>which columns</em> reach
        each agent. Submit a plan and the WASM-compiled rewriter
        answers: <em>rewrite</em> with a projected column list, or
        <em>refuse</em> with a reason.
      </p>
    </header>

    <section class="block">
      <h2>Cast — the three principals</h2>
      <p class="muted">
        Each principal is a department-scoped agent identity. The
        Postern gateway extracts the principal from a Biscuit token
        on every request and looks up the matching grants.
      </p>
      <div class="cast">
        <article class="cast-card">
          <header>
            <h3><code>CRM</code></h3>
            <span class="muted small">Customer Relationship Management</span>
          </header>
          <p>
            Runs marketing segmentation and customer-support
            lookups. Needs to identify a user by
            <code>id</code>/<code>name</code> and know their
            <code>region</code> and <code>age</code> for campaign
            targeting. Has <strong>no business reason</strong> to
            see cards, transactions, or PII like
            <code class="sensitive">ssn</code> /
            <code class="sensitive">email</code>.
          </p>
          <p class="grant-line">
            <strong>Allowed:</strong>
            <code>users_data.&#123;id, name, region, age&#125;</code>
          </p>
        </article>

        <article class="cast-card">
          <header>
            <h3><code>CardOps</code></h3>
            <span class="muted small">Card Operations</span>
          </header>
          <p>
            Handles card issuance, activation, and limit changes.
            Needs the card-level attributes
            (<code>card_id</code>, <code>card_type</code>,
            <code>limit</code>, <code>activated</code>) but
            <strong>must never see the full
            <code class="sensitive">card_number</code></strong>
            (PAN — PCI-DSS scope) and has no business with users or
            transactions in this scenario.
          </p>
          <p class="grant-line">
            <strong>Allowed:</strong>
            <code>cards_data.&#123;card_id, card_type, limit, activated&#125;</code>
          </p>
        </article>

        <article class="cast-card">
          <header>
            <h3><code>FraudRisk</code></h3>
            <span class="muted small">Fraud &amp; Risk Analytics</span>
          </header>
          <p>
            Investigates anomalous spend patterns. Needs the full
            transactions table to compute spend signatures
            <em>and</em> a minimum-necessary slice of users
            (just <code>id</code> + <code>region</code>) to bucket
            by geography. Does not need
            <code>name</code>/<code>age</code> for the model and
            never sees PII or PAN.
          </p>
          <p class="grant-line">
            <strong>Allowed:</strong>
            <code>transactions_data.&#123;txn_id, card_id, amount, merchant, timestamp&#125;</code>
            +
            <code>users_data.&#123;id, region&#125;</code>
          </p>
        </article>
      </div>
      <p class="muted small">
        Any principal not in this list (e.g. <code>Marketing</code>,
        a contractor) falls through the fail-closed default — the
        rewriter returns an empty projection, never the raw rows.
      </p>
    </section>

    <section class="block">
      <h2>1. Raw data</h2>
      <p class="muted">
        Synthetic samples — same schema as the Kaggle
        <code>transactions-fraud-datasets</code>. Sensitive columns are flagged
        <span class="sensitive">like this</span>; the policy must never release
        them.
      </p>

      <div class="tables">
        {
          relations.map((rel) => (
            <article class="table-card">
              <header>
                <h3>
                  <code>{rel}</code>
                </h3>
                <span class="muted small">
                  {TABLES[rel].length} rows &middot; {CATALOG[rel].length} columns
                </span>
              </header>
              <table>
                <thead>
                  <tr>
                    {CATALOG[rel].map((col) => (
                      <th
                        class={(SENSITIVE[rel] ?? []).includes(col) ? "sensitive" : undefined}
                      >
                        {col}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {TABLES[rel].map((row) => (
                    <tr>
                      {CATALOG[rel].map((col) => (
                        <td
                          class={(SENSITIVE[rel] ?? []).includes(col) ? "sensitive" : undefined}
                        >
                          {String(row[col])}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </article>
          ))
        }
      </div>
    </section>

    <section class="block">
      <h2>2. Policy</h2>
      <p class="muted">
        Surface syntax (left) is sugar over a list of <code>right(p, r, c)</code>
        facts (right) — one fact per principal/relation/column triple.
      </p>
      <div class="policy-grid">
        <div>
          <h3 class="policy-title">policy.postern</h3>
          <pre class="policy-postern">{policyText}</pre>
        </div>
        <div>
          <h3 class="policy-title">Datalog desugaring</h3>
          <pre class="policy-datalog">{datalogText}</pre>
        </div>
      </div>
    </section>

    <section class="block">
      <h2>2b. The biscuit on the wire</h2>
      <p class="muted">
        On every request, <code>biscuit_auth::datalog::World</code> is
        loaded with two layers of Datalog before evaluating an
        <code>allow if right($p, $r, $c)</code> query. Pick a principal
        below to see the bearer block update.
      </p>
      <div class="policy-grid biscuit-grid">
        <div>
          <h3 class="policy-title">
            Authority block
            <span class="biscuit-source biscuit-source--gw">gateway-loaded</span>
          </h3>
          <p class="muted small biscuit-cap">
            Compiled from <code>policy.postern</code> at gateway startup
            and re-added via <code>World::add_fact</code> per request.
            Trusted by construction; not signed by the bearer.
          </p>
          <pre class="policy-datalog biscuit-pane biscuit-pane--gw">{datalogText}</pre>
        </div>
        <div>
          <h3 class="policy-title">
            Bearer token
            <span class="biscuit-source biscuit-source--bearer" id="biscuit-principal-label">CRM</span>
          </h3>
          <p class="muted small biscuit-cap">
            Ed25519-signed by the issuer (the bank's IAM). Carries only
            the principal identity — no rights, no scope.
          </p>
          <pre class="policy-datalog biscuit-pane biscuit-pane--bearer" id="biscuit-bearer-logical">user(&quot;CRM&quot;).</pre>
          <h4 class="biscuit-subhead">Serialized (mock)</h4>
          <pre class="biscuit-wire" id="biscuit-bearer-wire">En0KEwoEQ1JNGAMiCQoHCAoSAxiACBIkCAASIA...</pre>
        </div>
      </div>
      <p class="muted small biscuit-note">
        <strong>Not modelled in this artifact</strong> (paper §6 open
        problems): <em>attenuation</em> (3rd-party caveats narrowing
        the bearer's rights), <em>audience</em> (binding the token to
        one gateway URL), <em>expiry</em> (<code>check if time($t),
        $t &lt; 2026-06-01T00:00:00Z</code>), <em>key rotation</em>
        (root-key rollover without re-issuing every bearer). The
        serialized blob is a mock — not a valid Ed25519-signed token —
        because the WASM bundle doesn't ship biscuit-auth today.
      </p>
    </section>

    <section class="block">
      <h2>3. Try it</h2>

      <form id="rewrite-form" class="form" autocomplete="off">
        <fieldset>
          <legend>Principal</legend>
          <div class="radio-row" id="principal-group">
            {
              PRINCIPALS.map((p, i) => (
                <label>
                  <input
                    type="radio"
                    name="principal"
                    value={p}
                    checked={i === 0}
                  />
                  <span>{p}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>Relation</legend>
          <select id="relation-select" name="relation">
            {relations.map((r) => <option value={r}>{r}</option>)}
          </select>
        </fieldset>

        <fieldset>
          <legend>Columns to project (Plan: Scan → Project)</legend>
          <div class="columns" id="columns-list" />
          <p class="muted small">
            Columns shown in <span class="sensitive">red</span> are
            policy-sensitive for <em>some</em> principal — PII, PAN, or
            similarly scoped fields. They aren't blocked at the form
            level; submit and the rewriter will drop them if the chosen
            principal lacks a grant. Leave the list empty to project
            nothing (output schema will be policy-allowed columns only).
          </p>
        </fieldset>

        <fieldset>
          <legend>Optional filter column (Plan: ... → Filter)</legend>
          <select id="filter-select" name="filter">
            <option value="">— none —</option>
          </select>
          <p class="muted small">
            The rewriter refuses if the filter column isn't in the principal's grant set.
          </p>
        </fieldset>

        <div class="actions">
          <button type="submit" class="cta cta--primary">Rewrite plan</button>
          <button type="reset" class="cta">Reset</button>
        </div>
      </form>

      <output id="result" class="result" aria-live="polite">
        <p class="muted">Pick options and submit to see the rewrite.</p>
      </output>

      <details class="about">
        <summary>About this demo</summary>
        <ul>
          <li>
            The WASM binary is the <strong>column-grant rewriter</strong>
            (<code>postern-core::rewrite</code>) compiled to
            <code>wasm32-unknown-unknown</code> via <code>wasm-pack</code>.
            It mirrors the Lean reference one-for-one.
          </li>
          <li>
            Refusal reasons surfaced: <em>unknown relation</em>
            (catalog lookup empty) and <em>filter on forbidden
            column</em> (predicate touches columns outside the principal's
            grants).
          </li>
          <li>
            Plan IR uses three operators only — <code>Scan</code>,
            <code>Project</code>, <code>Filter</code> — matching the
            inductive defined in <code>verifier/lean/Postern.lean</code>.
          </li>
        </ul>
      </details>
    </section>
  </main>

  <script
    is:inline
    type="application/json"
    id="demo-config"
    set:html={JSON.stringify(demoConfig)}
  />

  <script>
    import init, { rewrite_plan } from "../wasm/postern_wasm.js";
    import wasmUrl from "../wasm/postern_wasm_bg.wasm?url";

    type Row = Record<string, string | number | boolean>;
    interface DemoConfig {
      catalog: Record<string, string[]>;
      policy: Array<{ principal: string; relation: string; columns: string[] }>;
      principals: ReadonlyArray<string>;
      sensitive: Record<string, ReadonlyArray<string>>;
      tables: Record<string, Row[]>;
    }

    type Plan =
      | { op: "scan"; rel: string }
      | { op: "project"; sub: Plan; cols: string[] }
      | { op: "filter"; sub: Plan; col: string };

    const configEl = document.getElementById("demo-config") as HTMLScriptElement | null;
    if (!configEl) throw new Error("demo-config script tag missing");
    const cfg: DemoConfig = JSON.parse(configEl.textContent ?? "{}");

    const relationSelect = document.getElementById("relation-select") as HTMLSelectElement;
    const filterSelect = document.getElementById("filter-select") as HTMLSelectElement;
    const columnsList = document.getElementById("columns-list") as HTMLDivElement;
    const form = document.getElementById("rewrite-form") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;

    function escape(s: string): string {
      return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function refreshColumnList(): void {
      const rel = relationSelect.value;
      const cols = cfg.catalog[rel] ?? [];
      const sensitive = cfg.sensitive[rel] ?? [];

      columnsList.innerHTML = cols
        .map((c) => {
          const tag = sensitive.includes(c) ? ' class="sensitive"' : "";
          return `<label class="col-pick"><input type="checkbox" name="col" value="${escape(c)}" /> <code${tag}>${escape(c)}</code></label>`;
        })
        .join("");

      filterSelect.innerHTML =
        `<option value="">— none —</option>` +
        cols
          .map(
            (c) =>
              `<option value="${escape(c)}">${escape(c)}</option>`,
          )
          .join("");
    }

    relationSelect.addEventListener("change", refreshColumnList);
    refreshColumnList();

    // --- §2b: per-principal biscuit panes ---------------------------------
    // Mock tokens — purely for visual flavor; not real biscuits. The leading
    // bytes mimic a biscuit v3 protobuf header (En0K... = `0x12 0x7d 0x0a`)
    // so the shape is plausible without minting actual Ed25519 signatures.
    const MOCK_BEARER_TOKENS: Record<string, string> = {
      CRM: "En0KEwoEQ1JNGAMiCQoHCAoSAxiACBIkCAASIB7n3T_pmqXcZmAYqGmU0AdgWxPq",
      CardOps: "En4KFAoHQ2FyZE9wcxgDIgkKBwgKEgMYgAgSJAgAEiB9KqL2vXmYcZmA0Bjpc",
      FraudRisk: "En8KFgoJRnJhdWRSaXNrGAMiCQoHCAoSAxiACBIkCAASIPMtR9nyzAhWcXqV",
    };

    const biscuitPrincipalLabel = document.getElementById(
      "biscuit-principal-label",
    ) as HTMLElement | null;
    const biscuitLogical = document.getElementById(
      "biscuit-bearer-logical",
    ) as HTMLElement | null;
    const biscuitWire = document.getElementById(
      "biscuit-bearer-wire",
    ) as HTMLElement | null;

    function refreshBiscuitPane(principal: string): void {
      if (biscuitPrincipalLabel) biscuitPrincipalLabel.textContent = principal;
      if (biscuitLogical) {
        biscuitLogical.textContent = `user("${principal}").`;
      }
      if (biscuitWire) {
        biscuitWire.textContent =
          MOCK_BEARER_TOKENS[principal] ?? MOCK_BEARER_TOKENS.CRM!;
      }
    }

    const principalGroup = document.getElementById("principal-group");
    principalGroup?.addEventListener("change", (e) => {
      const tgt = e.target as HTMLInputElement | null;
      if (tgt && tgt.name === "principal") refreshBiscuitPane(tgt.value);
    });
    refreshBiscuitPane(cfg.principals[0] ?? "CRM");

    // Build the input plan IR from form selections.
    function buildPlan(formData: FormData): Plan {
      const rel = String(formData.get("relation"));
      const cols = formData.getAll("col").map(String);
      const filter = String(formData.get("filter") ?? "");

      let plan: Plan = { op: "scan", rel };
      if (filter) plan = { op: "filter", sub: plan, col: filter };
      if (cols.length > 0) plan = { op: "project", sub: plan, cols };
      return plan;
    }

    let wasmReady: Promise<void> | null = null;
    function ensureWasm(): Promise<void> {
      if (!wasmReady) {
        wasmReady = init({ module_or_path: wasmUrl as unknown as string }).then(() => {});
      }
      return wasmReady;
    }

    // Render a plan as an approximate SQL string. The Plan IR has no
    // predicate value attached to Filter (paper §Plan IR), so we
    // surface filter columns as `WHERE <col> IS NOT NULL` for shape.
    function planToSql(plan: Plan): string {
      // Walk top-down to collect the projection, filter cols, and base rel.
      let cols: string[] | "*" = "*";
      const filters: string[] = [];
      let cur: Plan = plan;
      while (cur.op !== "scan") {
        if (cur.op === "project") {
          // Outermost Project wins (it narrows further).
          if (cols === "*") cols = cur.cols.slice();
          cur = cur.sub;
        } else {
          filters.push(cur.col);
          cur = cur.sub;
        }
      }
      const rel = cur.rel;
      const projectClause =
        cols === "*"
          ? "*"
          : cols.length === 0
            ? "/* nothing */"
            : cols.join(", ");
      const whereClause = filters.length
        ? "\nWHERE " + filters.map((c) => `${c} IS NOT NULL`).join(" AND ")
        : "";
      return `SELECT ${projectClause}\nFROM ${rel}${whereClause};`;
    }

    // Execute a plan against the synthetic tables. Returns the
    // (columns, rows) the agent would see if no policy were in place
    // (for the input plan) or after the rewrite (for the output plan).
    function executePlan(plan: Plan, tables: Record<string, Row[]>): {
      columns: string[];
      rows: Row[];
    } {
      if (plan.op === "scan") {
        const rows = tables[plan.rel] ?? [];
        const columns = cfg.catalog[plan.rel] ?? [];
        return { columns, rows };
      }
      if (plan.op === "filter") {
        // Filter side-channel is the column choice, not a predicate value;
        // demo passes rows through unchanged (the IR carries no value).
        return executePlan(plan.sub, tables);
      }
      const inner = executePlan(plan.sub, tables);
      // Project: keep only requested columns that exist in the inner schema.
      const keep = plan.cols.filter((c) => inner.columns.includes(c));
      const rows = inner.rows.map((r) => {
        const out: Row = {};
        for (const c of keep) out[c] = r[c]!;
        return out;
      });
      return { columns: keep, rows };
    }

    function renderTable(
      columns: string[],
      rows: Row[],
      sensitiveCols: ReadonlyArray<string> = [],
      emptyMsg = "(no columns released)",
    ): string {
      if (columns.length === 0) {
        return `<p class="df-empty">${escape(emptyMsg)}</p>`;
      }
      const thead = columns
        .map((c) => {
          const cls = sensitiveCols.includes(c) ? ' class="sensitive"' : "";
          return `<th${cls}>${escape(c)}</th>`;
        })
        .join("");
      const tbody = rows
        .map((r) => {
          const cells = columns
            .map((c) => {
              const cls = sensitiveCols.includes(c) ? ' class="sensitive"' : "";
              return `<td${cls}>${escape(String(r[c] ?? ""))}</td>`;
            })
            .join("");
          return `<tr>${cells}</tr>`;
        })
        .join("");
      return `<div class="df-wrap"><table class="df"><thead><tr>${thead}</tr></thead><tbody>${tbody}</tbody></table></div>`;
    }

    function renderResult(
      input: Plan,
      response:
        | { ok: true; allowed: string[]; output_plan: Plan }
        | { ok: false; reason: string; allowed: string[] },
      principal: string,
    ): string {
      const inputRel =
        input.op === "scan"
          ? input.rel
          : input.op === "project" && input.sub.op === "scan"
            ? input.sub.rel
            : "(unknown)";
      const sensitiveCols = cfg.sensitive[inputRel] ?? [];

      const allowedLine = response.allowed.length
        ? response.allowed.map((c) => `<code>${escape(c)}</code>`).join(" ")
        : '<em class="muted">(none — principal has no grants on this relation)</em>';

      const inputSql = `<pre class="sql">${escape(planToSql(input))}</pre>`;
      const inputExec = executePlan(input, cfg.tables);
      const inputDf = renderTable(
        inputExec.columns,
        inputExec.rows,
        sensitiveCols,
        "(plan asks for no columns)",
      );

      const headerLine = `
        <div class="result__cols">
          <strong>Policy-allowed columns</strong> for
          <code>${escape(principal)}</code> on
          <code>${escape(inputRel)}</code>: ${allowedLine}
        </div>
      `;

      if (response.ok) {
        const outputSql = `<pre class="sql sql--ok">${escape(planToSql(response.output_plan))}</pre>`;
        const outputExec = executePlan(response.output_plan, cfg.tables);
        const outputDf = renderTable(
          outputExec.columns,
          outputExec.rows,
          sensitiveCols,
          "(empty projection — no allowed columns intersected the request)",
        );
        return `
          <div class="result__head verdict verdict--ok">
            <span class="badge ok">accepted</span>
            <span>Rewritten to the policy-allowed projection over <code>${escape(inputRel)}</code>.</span>
          </div>
          ${headerLine}
          <div class="result__pair">
            <section class="result__col">
              <h4>Agent's request</h4>
              <p class="result__hint">What the agent asked the lake for (no policy).</p>
              ${inputSql}
              ${inputDf}
            </section>
            <section class="result__col">
              <h4>Through Postern</h4>
              <p class="result__hint">After the verified rewriter narrowed the projection.</p>
              ${outputSql}
              ${outputDf}
            </section>
          </div>
        `;
      }
      return `
        <div class="result__head verdict verdict--bad">
          <span class="badge bad">refused</span>
          <span>${escape(response.reason)}</span>
        </div>
        ${headerLine}
        <div class="result__pair">
          <section class="result__col">
            <h4>Agent's request</h4>
            <p class="result__hint">What the agent asked the lake for (no policy).</p>
            ${inputSql}
            ${inputDf}
          </section>
          <section class="result__col">
            <h4>Through Postern</h4>
            <p class="result__hint">Rewriter refused — no rows are released.</p>
            <pre class="sql sql--bad">-- refused: ${escape(response.reason)}</pre>
            <p class="df-empty">(no rows released)</p>
          </section>
        </div>
      `;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      result.innerHTML = `<p class="muted">Loading WASM…</p>`;
      try {
        await ensureWasm();
      } catch (err) {
        result.innerHTML = `<p class="muted">WASM failed to load: ${escape(String(err))}</p>`;
        return;
      }
      const fd = new FormData(form);
      const principal = String(fd.get("principal"));
      const plan = buildPlan(fd);
      const request = {
        catalog: cfg.catalog,
        policy: cfg.policy,
        principal,
        plan,
      };
      try {
        const response = rewrite_plan(request) as
          | { ok: true; allowed: string[]; output_plan: Plan }
          | { ok: false; reason: string; allowed: string[] };
        result.innerHTML = renderResult(plan, response, principal);
      } catch (err) {
        result.innerHTML = `<p class="muted">rewrite_plan errored: ${escape(String(err))}</p>`;
      }
    });

    form.addEventListener("reset", () => {
      // Defer until after defaults are re-applied.
      setTimeout(() => {
        refreshColumnList();
        refreshBiscuitPane(cfg.principals[0] ?? "CRM");
        result.innerHTML = `<p class="muted">Pick options and submit to see the rewrite.</p>`;
      }, 0);
    });
  </script>
</Base>

<style>
  .demo {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.4rem 1.2rem 4rem;
  }

  .demo__head {
    margin-bottom: 2rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }

  .demo h1 {
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0 0 0.4rem;
