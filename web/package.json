{
  "name": "postern-web",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../prototype/crates/postern-wasm --release --target web --out-dir ../../../web/src/wasm --out-name postern_wasm",
    "prebuild": "pnpm build:wasm",
    "predev": "pnpm build:wasm",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:cf": "wrangler pages deploy dist --project-name postern-web"
  },
  "dependencies": {
    "astro": "^6.3.7",
    "bibtex": "^0.9.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.4.0",
    "reveal.js": "^5.1.0",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/reveal.js": "^5.0.6",
    "typescript": "^6.0.3",
    "wrangler": "^3.91.0"
  }
}
